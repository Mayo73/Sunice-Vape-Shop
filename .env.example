# Copy to .env and fill in, then: docker compose up -d --build
# (Or just run ./deploy.sh, which writes this file for you.)
#
# Note: Vite inlines VITE_* variables at BUILD time, so changing them means
# rebuilding the image (docker compose up -d --build), not just restarting.

# ---------------------------------------------------------------- how to serve
# Two modes. Pick one.
#
#   1) Domain, automatic HTTPS -- needs DNS pointing at this server, and on
#      Cloudflare the record must be "DNS only" (grey cloud):
#
#          SITE_ADDRESS=vape.mlevo.de
#
#   2) Plain HTTP on the server's IP -- works immediately, no DNS at all.
#      The shop is then at http://<server-ip>/
#      Trade-off: browsers only allow geolocation on a secure origin, so the
#      admin "Use my location" button will not work and admins type the
#      meeting point instead. Everything else is identical.
#
#          SITE_ADDRESS=:80
#
SITE_ADDRESS=:80

# Host ports to publish. Change only if something else already uses 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- backend
# The publishable key is meant to be public: it only ever acts as the "anon"
# role, and row level security is what actually protects the data.
VITE_SUPABASE_URL=https://kfveyjwamkzmyrtripqy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_hgfDBWttjtjfDbJ4VaMmuw_jVtWofwX
