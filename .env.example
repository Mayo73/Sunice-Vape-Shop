# Copy to .env and fill in, then: docker compose up -d --build
#
# Note: Vite inlines VITE_* variables at BUILD time, so changing them means
# rebuilding the image (docker compose up -d --build), not just restarting.

# Domain Caddy should request a Let's Encrypt certificate for.
# The DNS record for this name must point at this server and, if it sits behind
# Cloudflare, must be set to "DNS only" (grey cloud) -- see README.
APP_DOMAIN=vape.mlevo.de

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Supabase project. The publishable key is meant to be public: it only ever acts
# as the "anon" role, and row level security is what actually protects the data.
VITE_SUPABASE_URL=https://kfveyjwamkzmyrtripqy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_hgfDBWttjtjfDbJ4VaMmuw_jVtWofwX
